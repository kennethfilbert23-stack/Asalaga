<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Container for Owner Fragments -->
    <FrameLayout
        android:id="@+id/owner_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/owner_bottom_nav"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Owner Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/owner_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="?attr/colorSurface"
        app:elevation="8dp"
        app:itemIconTint="@color/tab_color_selector"
        app:itemTextColor="@color/tab_color_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/owner_bottom_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
