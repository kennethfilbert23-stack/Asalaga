<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama Venue"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_venue_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rounded_card"
        android:hint="Contoh: Asalaga Futsal Arena"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Alamat Lengkap"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_venue_address"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rounded_card"
        android:hint="Contoh: Jl. Diponegoro No. 3 Jakarta"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Deskripsi &amp; Fasilitas"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_dialog_venue_desc"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_rounded_card"
        android:gravity="top|start"
        android:hint="Sebutkan fasilitas (Wifi, Kantin, Parkir Luas, dll.)"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

</LinearLayout>
