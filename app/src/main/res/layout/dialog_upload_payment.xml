<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unggah Bukti Pembayaran"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Unggah foto bukti transfer bank / e-wallet Anda. Bukti pembayaran akan langsung disimpan secara aman di Google Drive owner."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:gravity="center"
        android:lineSpacingExtra="2dp" />

    <!-- Total Bill Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_tag_pending"
        android:padding="10dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL TAGIHAN"
            android:textColor="@color/status_pending"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_upload_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rp 0"
            android:textColor="@color/status_pending"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Image Preview Container -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/img_upload_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:src="@drawable/ic_booking" />

            <!-- Progress bar overlay during upload -->
            <RelativeLayout
                android:id="@+id/layout_upload_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#A6000000"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progress_upload"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/progress_upload"
                    android:layout_marginTop="12dp"
                    android:text="Mengunggah ke Drive..."
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Buttons -->
    <Button
        android:id="@+id/btn_select_image"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_rounded_card"
        android:text="Pilih Bukti Pembayaran"
        android:textColor="@color/blue_primary"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <Button
        android:id="@+id/btn_upload_submit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_blue"
        android:text="Unggah Bukti"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:enabled="false"
        app:backgroundTint="@null" />

</LinearLayout>
