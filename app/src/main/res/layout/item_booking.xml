<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_item_booking_venue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Asalaga Arena"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_item_booking_court"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lapangan Futsal A"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Status Tag -->
            <TextView
                android:id="@+id/tv_item_booking_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_pending"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="PENDING"
                android:textColor="@color/status_pending"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/grey_border" />

        <!-- Details grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanggal &amp; Waktu"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_booking_datetime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2026-05-27 • 14:00 - 16:00"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Biaya"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_booking_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rp 240.000"
                    android:textColor="@color/blue_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Customer specific details (shows Customer email/phone to Owner) -->
        <TextView
            android:id="@+id/tv_item_booking_customer_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Penyewa: Rachmat (081234567)"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Payment Proof Simulator Indicator and Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_item_booking_payment_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bukti Pembayaran: Belum diunggah"
                android:textColor="@color/status_cancelled"
                android:textSize="12sp"
                android:textStyle="italic" />

            <Button
                android:id="@+id/btn_view_proof"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_rounded_card"
                android:text="Lihat Bukti"
                android:textColor="@color/blue_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                android:visibility="gone"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Action Panel -->
        <LinearLayout
            android:id="@+id/layout_booking_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Cancel button (Owner/Customer can cancel if pending) -->
            <Button
                android:id="@+id/btn_booking_cancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_rounded_card"
                android:text="Batalkan"
                android:textColor="@color/status_cancelled"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                app:backgroundTint="@null" />

            <!-- Confirm/Upload button -->
            <Button
                android:id="@+id/btn_booking_action"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_blue"
                android:text="Upload Bukti Bayar"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                app:backgroundTint="@null" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
