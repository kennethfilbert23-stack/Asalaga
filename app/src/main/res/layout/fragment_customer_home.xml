<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- Header Panel -->
    <View
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_gradient_blue"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_home_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="54dp"
        android:text="Halo, Selamat Datang!"
        android:textColor="#BFDBFE"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_customer_profile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_profile"
        android:contentDescription="Profil"
        app:tint="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_home_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="Penyewa Lapangan"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_welcome" />

    <!-- Search Box Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_search"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="-25dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/home_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/et_home_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Cari nama venue olahraga..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Sport Category Title -->
    <TextView
        android:id="@+id/tv_cat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="Pilih Kategori Olahraga"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_search" />

    <!-- Category Selector Buttons -->
    <HorizontalScrollView
        android:id="@+id/scroll_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tv_cat_title">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <!-- Futsal -->
            <TextView
                android:id="@+id/btn_cat_futsal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_rounded_card"
                android:elevation="2dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="⚽ Futsal"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <!-- Badminton -->
            <TextView
                android:id="@+id/btn_cat_badminton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_rounded_card"
                android:elevation="2dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🏸 Badminton"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <!-- Basketball -->
            <TextView
                android:id="@+id/btn_cat_basketball"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_rounded_card"
                android:elevation="2dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🏀 Basket"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <!-- Tennis -->
            <TextView
                android:id="@+id/btn_cat_tennis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_card"
                android:elevation="2dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="🎾 Tennis"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Venues Section Title -->
    <TextView
        android:id="@+id/tv_venues_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="Daftar Venue Olahraga"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_categories" />

    <!-- RecyclerView of Venues -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_home_venues"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_venues_title" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_home_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tidak ada venue olahraga tersedia"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_venues_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
