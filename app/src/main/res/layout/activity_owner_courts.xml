<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_light">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_owner_courts"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blue_primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Kelola Venue"
        app:titleTextColor="@color/white" />

    <!-- NestedScrollView to prevent scroll conflicts and support scrolling the entire details panel -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar_owner_courts">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Venue Details Editing Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ubah Detail Venue"
                        android:textColor="@color/blue_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Venue Image Header -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/img_venue_photo_header"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/bg_gradient_blue" />

                            <!-- Progress Overlay for Venue Photo Upload -->
                            <RelativeLayout
                                android:id="@+id/layout_venue_upload_progress"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#A6000000"
                                android:gravity="center"
                                android:visibility="gone">

                                <ProgressBar
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:indeterminateTint="@color/white" />
                            </RelativeLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                    <Button
                        android:id="@+id/btn_change_venue_photo"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_rounded_card"
                        android:text="🖼️ Ubah Foto Venue"
                        android:textColor="@color/blue_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:layout_marginBottom="16dp"
                        app:backgroundTint="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alamat Venue"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_venue_address"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="Masukkan alamat lengkap venue..."
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi Venue"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/et_venue_desc"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_rounded_card"
                        android:hint="Masukkan deskripsi tempat olahraga..."
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:padding="12dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_muted"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btn_save_venue_details"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_blue"
                        android:text="Simpan Detail Venue"
                        android:textColor="@color/white"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Courts Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Daftar Lapangan"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- RecyclerView of Courts -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_owner_courts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tv_owner_courts_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:text="Belum ada lapangan terdaftar di venue ini"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button to Add Court -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_court"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="Tambah Lapangan"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/blue_primary"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
