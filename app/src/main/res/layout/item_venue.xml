<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Full-bleed Venue Image -->
        <ImageView
            android:id="@+id/img_item_venue"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_gradient_blue" />

        <!-- Padded Text Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_item_venue_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Asalaga Sport Center"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_item_venue_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📍 Jl. Pemuda No. 45, Jakarta"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_item_venue_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Deskripsi singkat venue..."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Status badge or Owner Actions -->
            <LinearLayout
                android:id="@+id/layout_venue_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tag_pending"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_venue_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENDING"
                    android:textColor="@color/status_pending"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_owner_venue_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:visibility="gone"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_manage_courts"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_rounded_card"
                    android:text="Kelola Venue"
                    android:textColor="@color/blue_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_admin_venue_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:visibility="gone"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_admin_reject"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_rounded_card"
                    android:text="Tolak"
                    android:textColor="@color/status_cancelled"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btn_admin_approve"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button_blue"
                    android:text="Setujui"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
